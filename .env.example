# Application
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Database (Neon — copy the connection string from your Neon dashboard)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?sslmode=require

# LLM: Google Gemini via its OpenAI-compatible API (key from aistudio.google.com/apikey).
# Any OpenAI-compatible provider works by changing LLM_BASE_URL, LLM_MODEL and the key.
GEMINI_API_KEY=your_gemini_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Embedding model (sentence-transformers — runs locally, no key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Retrieval
TOP_K=5
SIMILARITY_THRESHOLD=0.3
RETRIEVAL_CANDIDATE_K=20
HYBRID_SEARCH_ENABLED=true

# Reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# LLM generation
LLM_MODEL=gemini-2.5-flash
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1
# Thinking depth for models that support it; leave empty for models that don't (e.g. LLaMA on Groq)
LLM_REASONING_EFFORT=low
